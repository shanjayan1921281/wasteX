rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile access
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Business profile (public directory for industrial units & dealers)
    match /businesses/{businessId} {
      allow read, write: if true;
    }
    
    // Waste assessments (read allowed for report inspection, write allowed)
    match /wasteAssessments/{assessmentId} {
      allow read, write: if true;
    }
    
    // Waste intelligence reports (verified reports viewable with marketplace listings)
    match /wasteReports/{reportId} {
      allow read, write: if true;
    }
    
    // Waste listings in marketplace
    match /wasteListings/{listingId} {
      allow read, write: if true;
    }
    
    // Buyer material requirements
    match /materialRequirements/{requirementId} {
      allow read, write: if true;
    }
    
    // Matches
    match /buyerMatches/{matchId} {
      allow read, write: if true;
    }
    
    // Purchase requests
    match /purchaseRequests/{requestId} {
      allow read, write: if true;
    }
    
    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Waste Categories
    match /wasteCategories/{catId} {
      allow read, write: if true;
    }

    // Recycling requests
    match /recyclingRequests/{requestId} {
      allow read, write: if true;
    }

    // Recycled products
    match /recycledProducts/{productId} {
      allow read, write: if true;
    }

    // Consumer orders
    match /consumerOrders/{orderId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
